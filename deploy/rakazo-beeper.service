[Unit]
Description=Rakazo agents as Beeper chats
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.local/share/rakazo-beeper/config.toml
ConditionPathExists=%h/.local/share/rakazo-beeper/secrets/rakazo-token
ConditionPathExists=%h/.local/share/rakazo-beeper/secrets/database-key

[Service]
Type=simple
WorkingDirectory=%h/.local/share/rakazo-beeper
ExecStartPre=%h/.local/share/rakazo-beeper/bin/rakazo-beeper --config %h/.local/share/rakazo-beeper/config.toml check
ExecStart=%h/.local/share/rakazo-beeper/bin/rakazo-beeper --config %h/.local/share/rakazo-beeper/config.toml run
Environment=RAKAZO_BEEPER_KEY_FILE=%h/.local/share/rakazo-beeper/secrets/database-key
Environment=RAKAZO_PERSONAL_TOKEN_FILE=%h/.local/share/rakazo-beeper/secrets/rakazo-token
Environment=RUST_LOG=rakazo_beeper=info
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/rakazo-beeper/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStopSec=15

[Install]
WantedBy=default.target

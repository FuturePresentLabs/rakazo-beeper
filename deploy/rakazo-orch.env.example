# Copy to a mode-0600 orch.env beside config.toml. No token value belongs here:
# RAKAZO_ORCH_TOKEN_FILE points at the existing session/service token file.
# This is the current Rakazo session token; a dedicated service token is not
# issued upstream yet (see pm/rakazo/service-token-proposal.md).
RAKAZO_ORCH_URL=https://agents.fpl.dev
RAKAZO_ORCH_SPACE_ID=b66f30cc72e5beac43f6b9ad9c0d5c9b
RAKAZO_ORCH_BOT_ID=cmvic21mh001gkuffgxcmz7lb
RAKAZO_ORCH_THREAD_ID=REPLACE_WITH_THE_FLEET_ORCHESTRATOR_THREAD_ID
# EnvironmentFile values are literal: use absolute paths, not %h specifiers.
RAKAZO_ORCH_TOKEN_FILE=REPLACE_WITH_ABSOLUTE_PATH/secrets/rakazo-orch-token
RUST_LOG=rakazo_beeper=info
